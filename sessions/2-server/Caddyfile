# Caddy v2 HTTP/3 server for the MM '26 volumetric streaming tutorial.
#
# Each port serves the same V-PCC content. Session 4 attaches a different
# tc netem impairment to each port, so switching the client's port switches
# the network condition without touching the content.
#
# Caddy enables HTTP/3 (QUIC) automatically on HTTPS sites. "localhost" sites
# get a certificate from Caddy's internal CA.
#
# Start (inside WSL, from this folder):
#   QUIC_GO_DISABLE_GSO=true caddy run --config Caddyfile
#
# QUIC_GO_DISABLE_GSO=true matters: with GSO on, micro-reordering inside
# GSO bursts makes quic-go declare spurious losses and collapse its
# congestion window. See sessions/2-server/README.md.
#
# TODO(organizers): reconcile with the lab Caddyfile on vm-immersive-media
# (TLS and certificate trust for the Unity QUIC plugin in particular).

{
	admin off
	servers {
		protocols h1 h2 h3
	}
}

(content) {
	root * {$CONTENT_ROOT:../../content/thaidancer}
	file_server browse
	header Access-Control-Allow-Origin *
	log {
		output file caddy-access.log
	}
}

# Condition A: clean reference
localhost:5001 {
	import content
}

# Condition B: loss
localhost:5002 {
	import content
}

# Condition C: latency
localhost:5003 {
	import content
}

# Condition D: latency + loss
localhost:5004 {
	import content
}
